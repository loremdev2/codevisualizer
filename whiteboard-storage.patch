new file mode 100644
index 0000000..1f9a5ca
--- /dev/null
+++ b/src/app/api/me/whiteboards/[id]/assets/route.ts
@@ -0,0 +1,80 @@
+import { NextResponse, type NextRequest } from "next/server";
+
+import { getServiceClient } from "@/lib/db";
+import { getSessionUserId } from "@/lib/auth/session";
+import { requireSameOrigin } from "@/lib/security/csrf";
+import { WHITEBOARD_ASSETS_BUCKET } from "@/lib/whiteboard-storage";
+
+const MAX_FILES_PER_REQUEST = 100;
+const MAX_FILE_BYTES = 25 * 1024 * 1024;
+const ALLOWED_TYPES = new Set([
+  "image/png",
+  "image/jpeg",
+  "image/webp",
+  "image/gif",
+  "image/svg+xml",
+]);
+
+export async function POST(
+  request: NextRequest,
+  { params }: { params: Promise<{ id: string }> },
+) {
+  const csrfError = requireSameOrigin(request);
+  if (csrfError) return csrfError;
+
+  const userId = await getSessionUserId(request);
+  if (!userId) {
+    return NextResponse.json({ error: "Sign in to upload whiteboard assets." }, { status: 401 });
+  }
+
+  let body: { files?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return NextResponse.json({ error: "Invalid JSON body." }, { status: 400 });
+  }
+  if (!Array.isArray(body.files) || body.files.length > MAX_FILES_PER_REQUEST) {
+    return NextResponse.json({ error: "Invalid whiteboard asset list." }, { status: 400 });
+  }
+
+  const { id: boardId } = await params;
+  const client = getServiceClient();
+  const { data: board, error: boardError } = await client
+    .from("whiteboards")
+    .select("id")
+    .eq("id", boardId)
+    .eq("user_id", userId)
+    .maybeSingle();
+  if (boardError || !board) {
+    return NextResponse.json({ error: "Whiteboard not found." }, { status: 404 });
+  }
+
+  const requests: { id: string; mimeType: string; size: number }[] = [];
+  for (const raw of body.files) {
+    if (!raw || typeof raw !== "object") {
+      return NextResponse.json({ error: "Invalid whiteboard asset." }, { status: 400 });
+    }
+    const file = raw as Record<string, unknown>;
+    if (
+      typeof file.id !== "string" || !/^[A-Za-z0-9_-]{1,128}$/.test(file.id) ||
+      typeof file.mimeType !== "string" || !ALLOWED_TYPES.has(file.mimeType) ||
+      typeof file.size !== "number" || !Number.isInteger(file.size) ||
+      file.size <= 0 || file.size > MAX_FILE_BYTES
+    ) {
+      return NextResponse.json({ error: "Unsupported or oversized whiteboard asset." }, { status: 400 });
+    }
+    requests.push({ id: file.id, mimeType: file.mimeType, size: file.size });
+  }
+
+  const uploads = await Promise.all(requests.map(async (file) => {
+    const extension = file.mimeType === "image/jpeg" ? "jpg" : file.mimeType.split("/")[1];
+    const path = `${userId}/${boardId}/${crypto.randomUUID()}.${extension}`;
+    const { data, error } = await client.storage
+      .from(WHITEBOARD_ASSETS_BUCKET)
+      .createSignedUploadUrl(path);
+    if (error || !data) throw new Error("Could not prepare whiteboard asset upload.");
+    return { id: file.id, path, signedUrl: data.signedUrl };
+  }));
+
+  return NextResponse.json({ uploads });
+}
diff --git a/src/lib/whiteboard-client-storage.ts b/src/lib/whiteboard-client-storage.ts
new file mode 100644
index 0000000..d04b870
--- /dev/null
+++ b/src/lib/whiteboard-client-storage.ts
@@ -0,0 +1,82 @@
+import { API, fetchJson } from "@/lib/api-config";
+import { WHITEBOARD_STORAGE_PREFIX } from "@/lib/whiteboard-storage";
+
+export type WhiteboardClientFile = {
+  id: string;
+  mimeType: string;
+  dataURL: string;
+  created: number;
+  [key: string]: unknown;
+};
+
+export async function uploadWhiteboardFiles(
+  boardId: string,
+  files: Record<string, WhiteboardClientFile>,
+  existingAssets: Record<string, string> = {},
+): Promise<
+  | { ok: true; files: Record<string, WhiteboardClientFile>; storageAssets: Record<string, string> }
+  | { ok: false; error: string }
+> {
+  const storageAssets = { ...existingAssets };
+  const pendingFiles = Object.values(files).filter(
+    (file) =>
+      !storageAssets[file.id] &&
+      (file.dataURL.startsWith("data:") || file.dataURL.startsWith("https://")),
+  );
+  const blobs = new Map<string, Blob>();
+  for (const file of pendingFiles) {
+    try {
+      blobs.set(file.id, await (await fetch(file.dataURL)).blob());
+    } catch {
+      return { ok: false, error: "Could not read a whiteboard image." };
+    }
+  }
+
+  if (pendingFiles.length > 0) {
+    const plan = await fetchJson<{
+      uploads?: { id: string; path: string; signedUrl: string }[];
+    }>(API.me.whiteboardAssets(boardId), {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        files: pendingFiles.map((file) => ({
+          id: file.id,
+          mimeType: file.mimeType,
+          size: blobs.get(file.id)?.size ?? 0,
+        })),
+      }),
+    });
+    if (!plan.ok || !plan.data.uploads) {
+      return { ok: false, error: plan.ok ? "Could not prepare image uploads." : plan.error };
+    }
+
+    const uploadsById = new Map(plan.data.uploads.map((upload) => [upload.id, upload]));
+    for (const file of pendingFiles) {
+      const upload = uploadsById.get(file.id);
+      const blob = blobs.get(file.id);
+      if (!upload || !blob) return { ok: false, error: "Could not prepare an image upload." };
+      const form = new FormData();
+      form.append("cacheControl", "31536000");
+      form.append("", blob, file.id);
+      try {
+        const response = await fetch(upload.signedUrl, { method: "POST", body: form });
+        if (!response.ok) {
+          return { ok: false, error: "Could not upload a whiteboard image. Please try again." };
+        }
+      } catch {
+        return { ok: false, error: "Could not upload a whiteboard image. Please try again." };
+      }
+      storageAssets[file.id] = upload.path;
+    }
+  }
+
+  const persistedFiles = Object.fromEntries(
+    Object.entries(files).map(([fileId, file]) => [
+      fileId,
+      storageAssets[file.id]
+        ? { ...file, dataURL: `${WHITEBOARD_STORAGE_PREFIX}${storageAssets[file.id]}` }
+        : file,
+    ]),
+  );
+  return { ok: true, files: persistedFiles, storageAssets };
+}
diff --git a/src/lib/whiteboard-storage.ts b/src/lib/whiteboard-storage.ts
new file mode 100644
index 0000000..994cd30
--- /dev/null
+++ b/src/lib/whiteboard-storage.ts
@@ -0,0 +1,48 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+
+export const WHITEBOARD_ASSETS_BUCKET = "whiteboard-assets";
+export const WHITEBOARD_STORAGE_PREFIX = "storage://";
+export const WHITEBOARD_SIGNED_URL_TTL_SECONDS = 60 * 60;
+
+export type WhiteboardAssetMap = Record<string, string>;
+
+export function getWhiteboardAssetMap(data: unknown): WhiteboardAssetMap {
+  if (!data || typeof data !== "object") return {};
+  const value = (data as Record<string, unknown>).storageAssets;
+  if (!value || typeof value !== "object" || Array.isArray(value)) return {};
+  return Object.fromEntries(
+    Object.entries(value).filter((entry): entry is [string, string] =>
+      typeof entry[1] === "string",
+    ),
+  );
+}
+
+/** Replace compact storage markers with temporary URLs only in API responses. */
+export async function hydrateWhiteboardAssets(
+  client: SupabaseClient,
+  data: unknown,
+): Promise<Record<string, unknown>> {
+  if (!data || typeof data !== "object") return {};
+  const result = structuredClone(data) as Record<string, unknown>;
+  const files = result.files;
+  const assets = getWhiteboardAssetMap(result);
+  const entries = Object.entries(assets);
+  if (!files || typeof files !== "object" || entries.length === 0) return result;
+
+  const { data: signed, error } = await client.storage
+    .from(WHITEBOARD_ASSETS_BUCKET)
+    .createSignedUrls(entries.map(([, path]) => path), WHITEBOARD_SIGNED_URL_TTL_SECONDS);
+  if (error) throw new Error("Could not create whiteboard asset URLs.");
+
+  const signedByPath = new Map((signed ?? []).map((item) => [item.path, item.signedUrl]));
+  const hydratedFiles = { ...(files as Record<string, Record<string, unknown>>) };
+  for (const [fileId, path] of entries) {
+    const signedUrl = signedByPath.get(path);
+    if (signedUrl && hydratedFiles[fileId]) {
+      hydratedFiles[fileId] = { ...hydratedFiles[fileId], dataURL: signedUrl };
+    }
+  }
+  result.files = hydratedFiles;
+  return result;
+}
+
diff --git a/supabase/migrations/20261111123551_whiteboard_storage_assets.sql b/supabase/migrations/20261111123551_whiteboard_storage_assets.sql
